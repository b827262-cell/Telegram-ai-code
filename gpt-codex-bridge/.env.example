# Never commit a populated copy of this file.
CODEX_ALLOWED_WORKSPACES=/home/b827262/project/example-repo
CODEX_DEFAULT_WORKSPACE=/home/b827262/project/example-repo

# Telegram long polling credentials. Keep these in systemd credentials or a
# root/user-readable EnvironmentFile with mode 0600, not in Git or logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Remote TUF A16 Meeting Room. Never commit a populated token.
MEETING_ROOM_URL=http://10.0.3.67:8000
MEETING_API_TOKEN=

# Optional runtime tuning.
CODEX_JOB_TIMEOUT_SECONDS=3600
CLAUDE_JOB_TIMEOUT_SECONDS=3600
GITHUB_REPORT_ENABLED=false
GITHUB_CLI_BIN=gh
GITHUB_REPORT_BRANCH=main
GITHUB_REPORT_DIRECTORY=reports/auto-loop
GITHUB_REPORT_TIMEOUT_SECONDS=30
CODEX_WORKER_POLL_SECONDS=1
CODEX_API_HOST=127.0.0.1
CODEX_API_PORT=4300
CODEX_BRIDGE_API_TOKEN=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=45
